{
  "manifest_version": 3,
  "name": "PageTurner · 轻翻页",
  "version": "1.4.0",
  "description": "Quiet comic reading with slow scrolling, halfway pauses and automatic page turns · JamieTso",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "PageTurner" },
  "icons": { "128": "icon.png" }
}
